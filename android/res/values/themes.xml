<?xml version="1.0" encoding="utf-8"?>
<!-- Thème clair le jour, sombre la nuit (values-night) : depuis Android 13, la WebView en tire prefers-color-scheme,
     donc le thème « Automatique » de l'interface suit celui du téléphone. -->
<resources>
  <style name="Theme.Lezard" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@color/bars</item>
    <item name="android:statusBarColor">@color/bars</item>
    <item name="android:navigationBarColor">@color/bars</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:colorAccent">@color/accent</item>
  </style>
</resources>
